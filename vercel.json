{
  "framework": "nextjs",
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "crons": [
    {
      "path": "/api/cron/sync-membership-orders",
      "schedule": "0 14 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "shmspto.org" }],
      "destination": "https://www.shmspto.org/:path*",
      "permanent": true
    }
  ]
}
