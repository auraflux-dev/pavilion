# Wix (required)
WIX_SITE_ID=509fda24-8dbf-43c6-aa74-df9f8b63c388
WIX_API_KEY=
NEXT_PUBLIC_WIX_CLIENT_ID=

# Public site URL — use https://shmspto.vercel.app before DNS, then https://www.shmspto.org
NEXT_PUBLIC_SITE_URL=https://shmspto.vercel.app

# Google Analytics 4 (optional until set — Measurement ID looks like G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-

# Meta Pixel (Facebook + Instagram ads / Events Manager — one ID covers both)
# NEXT_PUBLIC_META_PIXEL_ID=

# Optional legacy product-page base (unused once headless /api/checkout/start is live)
# NEXT_PUBLIC_STORE_BASE_URL=https://www.shmspto.org/product-page

# Cheddarup webhook
CHEDDARUP_WEBHOOK_SECRET=

# Wix eCommerce order-paid → apply Ruby/Supreme to Students
# POST https://www.shmspto.org/api/webhooks/wix-orders?token=...
WIX_ORDERS_WEBHOOK_SECRET=

# Vercel Cron → /api/cron/sync-membership-orders (Bearer auth; set by vercel env)
CRON_SECRET=

# Square — in-portal card checkout (membership, The Cove, store-card). Sandbox locally; production on Vercel.
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_NOTIFICATION_URL=https://shmspto.vercel.app/api/webhooks/square

# PayPal — optional; wires next to Square for any ecommerce (see docs/PAYPAL-SETUP.md)
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENVIRONMENT=sandbox

# Mass email via Gmail API / Google Workspace (optional — without it, staff use mailto BCC)
# One-time setup: GMAIL_CLIENT_ID=... GMAIL_CLIENT_SECRET=... node ../scripts/gmail-oauth-setup.mjs
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER=membership@shmspto.org
# GMAIL_FROM_NAME=SHMS PTO

# Staff hub (Inbox / My calendar / Docs) — preferred: service account + domain-wide delegation
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional PTO Shared drive / folder for Docs list:
# GOOGLE_DRIVE_FOLDER_ID=
# Fallback without delegation: OAuth Connect (stores tokens in CMS StaffGoogleTokens)
# Parent Google sign-in (External / public OAuth client — required for @gmail.com parents).
# Do not reuse the staff Internal client (org_internal blocks personal Gmail).
# GOOGLE_MEMBER_CLIENT_ID=
# GOOGLE_MEMBER_CLIENT_SECRET=
# Authorized redirect URI: https://www.shmspto.org/api/auth/google/callback
#
# Staff Workspace Google (often Internal to @shmspto.org):
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Authorized redirect: https://YOUR_SITE/api/staff/workspace/connect/callback

# ── Security / monitoring / backups (see docs/SECURITY-OPS.md) ──────────────
# Master switch for ErrorEvents CMS + optional webhook + /api/errors/report
# ERROR_REPORTING_ENABLED=true
# Optional Slack/Discord/etc sink when reporting is on:
# ERROR_WEBHOOK_URL=
# Extra allowed browser origins (comma-separated) for CSRF checks:
# ALLOWED_ORIGINS=

# Nightly CMS backup → Cloudflare R2 (not SQLite — Wix CMS is source of truth)
# Same R2 account/bucket as AuraFlux; objects land under shmspto/cms/
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BACKUP_BUCKET=auraflux-backups

# UptimeRobot: monitor https://www.shmspto.org/api/health every 5 minutes
# Optional API automation:
# UPTIMEROBOT_API_KEY=
