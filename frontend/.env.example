# Wix (required)
WIX_SITE_ID=509fda24-8dbf-43c6-aa74-df9f8b63c388
WIX_API_KEY=
NEXT_PUBLIC_WIX_CLIENT_ID=

# Public site URL — use https://shmspto.vercel.app before DNS, then https://www.shmspto.org
NEXT_PUBLIC_SITE_URL=https://shmspto.vercel.app

# Optional legacy product-page base (unused once headless /api/checkout/start is live)
# NEXT_PUBLIC_STORE_BASE_URL=https://www.shmspto.org/product-page

# Cheddarup webhook
CHEDDARUP_WEBHOOK_SECRET=

# Wix eCommerce order-paid → apply Ruby/Supreme to Students
# POST https://www.shmspto.org/api/webhooks/wix-orders?token=...
WIX_ORDERS_WEBHOOK_SECRET=

# Vercel Cron → /api/cron/sync-membership-orders (Bearer auth; set by vercel env)
CRON_SECRET=

# Square gift cards. Keep sandbox locally; Vercel Production must use production.
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_NOTIFICATION_URL=https://shmspto.vercel.app/api/webhooks/square

# Mass email via Gmail API / Google Workspace (optional — without it, staff use mailto BCC)
# One-time setup: GMAIL_CLIENT_ID=... GMAIL_CLIENT_SECRET=... node ../scripts/gmail-oauth-setup.mjs
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER=membership@shmspto.org
# GMAIL_FROM_NAME=SHMS PTO

# Staff hub (Inbox / My calendar / Docs) — preferred: service account + domain-wide delegation
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional PTO Shared drive / folder for Docs list:
# GOOGLE_DRIVE_FOLDER_ID=
# Fallback without delegation: OAuth Connect (stores tokens in CMS StaffGoogleTokens)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Authorized redirect: https://YOUR_SITE/api/staff/workspace/connect/callback
