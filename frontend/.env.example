# Wix (required)
WIX_SITE_ID=509fda24-8dbf-43c6-aa74-df9f8b63c388
WIX_API_KEY=
NEXT_PUBLIC_WIX_CLIENT_ID=

# Public site URL — must match the host users hit (Vercel URL pre-DNS, then https://www.shmspto.org)
NEXT_PUBLIC_SITE_URL=https://www.shmspto.org

# Optional: after DNS, point store checkout links at the canonical host
# e.g. https://www.shmspto.org/store   or keep unset to use the Wix storefront
# NEXT_PUBLIC_STORE_BASE_URL=https://www.shmspto.org/product-page

# Cheddarup webhook
CHEDDARUP_WEBHOOK_SECRET=

# Wix eCommerce order-paid → apply Ruby/Supreme to Students
# POST https://www.shmspto.org/api/webhooks/wix-orders?token=...
WIX_ORDERS_WEBHOOK_SECRET=

# Vercel Cron → /api/cron/sync-membership-orders (Bearer auth; set by vercel env)
CRON_SECRET=

# Square gift cards (production before go-live)
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_NOTIFICATION_URL=https://www.shmspto.org/api/webhooks/square
