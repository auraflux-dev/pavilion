# Copy to .env.development for local UI work (no production keys).
# Agents and routine dev should use this file only — never .env.local with prod Wix/Plaid/Square.

# Synthetic staging: fixture roster/checkout/budget only (no live Wix reads).
STAGING_SYNTHETIC_DATA=true

NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3022
NEXT_PUBLIC_WIX_SITE_ID=
WIX_SITE_ID=
WIX_API_KEY=

# Leave empty for code-only work. Use a sandbox Wix site if you need CMS reads in dev.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_SENDER=
GMAIL_REFRESH_TOKEN=

CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_OAUTH_REDIRECT_BASE=http://127.0.0.1:3022
