{
  "dependencies": {
    "next": "16.2.6"
  },
  "devDependencies": {
    "@wix/cli": "^1.0.0",
    "@wix/eslint-plugin-cli": "^1.0.0",
    "eslint": "^8.25.0",
    "react": "16.14.0"
  },
  "scripts": {
    "postinstall": "node -e \"if (process.env.VERCEL || process.env.CI) { console.log('skip wix sync-types on CI/Vercel'); process.exit(0) } require('child_process').execSync('wix sync-types', {stdio:'inherit'})\"",
    "sync-types": "wix sync-types",
    "vercel-build": "npm run build --prefix frontend",
    "build": "npm run build --prefix frontend",
    "dev": "wix dev",
    "lint": "eslint .",
    "ship": "node scripts/ship-pavilion.mjs --target commons-pto-demo",
    "ship:site": "node scripts/ship-pavilion.mjs --target commons-site"
  }
}
